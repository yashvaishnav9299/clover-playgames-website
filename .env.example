# =============================================================================
# CLOVER PLAY GAMES — Environment & Deployment Configuration Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# Primary production domain purchased on Hostinger (e.g., cloverplaygames.com)
DOMAIN_NAME=cloverplaygames.com

# Hostinger API Token (hPanel -> Account Information -> API)
# Used to manage DNS zones, records (A, CNAME, MX, TXT), and hosting via API
HOSTINGER_API_TOKEN=your_hostinger_api_token_here

# Optional: Hostinger SSH / SFTP deployment credentials (only if using Hostinger Web Hosting instead of GitHub Pages)
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_PORT=65002
HOSTINGER_SSH_USER=
HOSTINGER_WEB_ROOT=public_html

# Optional: GitHub Personal Access Token (repo + pages scope)
# Used to configure GitHub Pages & custom domain via GitHub REST API
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=yashvaishnav9299/clover-playgames-website
